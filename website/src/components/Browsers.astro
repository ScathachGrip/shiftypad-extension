          </svg>
          <span>Chrome</span>
        </div>
        <div class="browser-item" title="Brave Browser">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
             <path d="M12 0L14.6 7.6H22.4L16.2 12.2L18.8 19.8L12.6 15.2L6.4 19.8L9 12.2L2.8 7.6H10.6L12 0Z"/>
          </svg>
          <span>Brave</span>
        </div>
        <div class="browser-item" title="Microsoft Edge">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2.4c5.31 0 9.6 4.29 9.6 9.6s-4.29 9.6-9.6 9.6-9.6-4.29-9.6-9.6 4.29-9.6 9.6-9.6z"/>
          </svg>
          <span>Edge</span>
        </div>
        <div class="browser-item" title="Opera">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2.4c5.31 0 9.6 4.29 9.6 9.6s-4.29 9.6-9.6 9.6-9.6-4.29-9.6-9.6 4.29-9.6 9.6-9.6z"/>
          </svg>
          <span>Opera</span>
        </div>
        <div class="browser-item" title="Arc Browser">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2.4c5.31 0 9.6 4.29 9.6 9.6s-4.29 9.6-9.6 9.6-9.6-4.29-9.6-9.6 4.29-9.6 9.6-9.6z"/>
          </svg>
          <span>Arc</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .browsers-wrap {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  [data-theme="dark"] .browsers-wrap {
    background: rgba(0, 0, 0, 0.2);
  }

  .browsers-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .browsers-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    opacity: 0.6;
  }

  .browsers-list {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .browser-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    transition: all 0.3s ease;
    filter: grayscale(1);
    opacity: 0.5;
  }

  .browser-item:hover {
    filter: grayscale(0);
    opacity: 1;
    color: var(--text);
    transform: translateY(-1px);
  }

  .browser-item span {
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .browsers-inner {
      flex-direction: column;
      gap: 16px;
    }
    
    .browsers-list {
      gap: 16px;
    }
    
    .browser-item span {
      display: none;
    }
  }
</style>
