---
import { readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
const __dirname = dirname(fileURLToPath(import.meta.url));
const manifestPath = resolve(__dirname, "../../../manifest.json");
const manifest = JSON.parse(readFileSync(manifestPath, "utf-8"));
const versionTag = manifest.version_name || `v${manifest.version}`;
---
<section class="hero">
  <div class="hero-bg">
    <img src="/hero.png" alt="" class="hero-bg-img" />
  </div>
  <div class="container hero-inner">
    <div class="hero-text">
      <span class="tag">{versionTag}</span>
      <h1>Union Raid data,<br /><span class="gradient-text">right where you need it.</span></h1>
      <p class="hero-desc">
        Scrape, cache, and visualise your Blablalink Union Raid results.
        Interactive charts, season-aware storage, and one-click export.
      </p>
      <div class="hero-actions">
        <a href="#installation" class="btn btn-primary">Install Extension</a>
        <a href="https://github.com/ScathachGrip/shiftypad-extension" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View on GitHub</a>
      </div>
    </div>
    <div class="hero-visual">
      <img src="/app.png" alt="Shiftypad Extension" class="hero-app-img" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    overflow: hidden;
    background: var(--bg);
  }

  /* Background - Normal & Sharp */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-bg-img {
    width: 100%;
    height: 110%;
    position: absolute;
    top: -5%;
    left: 0;
    object-fit: cover;
    animation: hero-up-down 3s infinite alternate cubic-bezier(0.45, 0, 0.55, 1);
    will-change: transform;
  }

  @keyframes hero-up-down {
    from { transform: translateY(0); }
    to { transform: translateY(30px); }
  }

  [data-theme="light"] .hero-bg-img {
    opacity: 0.4; /* Slightly faded for light mode readability, but no blur */
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    z-index: 5;
    max-width: 1200px;
  }

  .hero-text {
    position: relative;
    z-index: 10;
  }

  .hero-text h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
    color: var(--text);
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: flex-start;
    z-index: 10;
  }

  .hero-app-img {
    width: 100%;
    max-width: 720px;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border);
    margin-left: -80px;
    transform: perspective(1200px) rotateY(-25deg) rotateX(10deg) rotateZ(-4deg);
    transition: transform 0.3s ease;
  }

  .hero-app-img:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg) rotateZ(0deg) scale(1.02);
  }

  [data-theme="light"] .hero-app-img {
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 992px) {
    .hero-inner {
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 120px 0 80px;
    }

    .hero-bg {
      width: 100%;
      opacity: 0.2;
      mask-image: none;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-desc {
      margin: 0 auto 32px;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      display: none;
    }
  }
</style>
