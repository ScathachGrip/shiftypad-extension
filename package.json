{
  "name": "shiftypad-extension",
  "version": "0.1.12",
  "description": "Blablalink extension with Union Raid data focused.",
  "apexcharts_browser": "https://cdn.jsdelivr.net/npm/apexcharts@5.3.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScathachGrip/shiftypad-extension.git"
  },
  "author": "sinkaroid",
  "scripts": {
    "clean:build": "bun run clean && bun run build && bun run release",
    "clean": "rm -rf dist",
    "download:apex": "bun ci/downloadApex.ts",
    "build": "bun ci/build.ts",
    "release": "bun ci/release.ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"ci/**/*.ts\" \"astro/**/*.astro\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"ci/**/*.ts\" \"astro/**/*.astro\" --fix",
    "qlty": "qlty check --all",
    "qlty:smells": "qlty smells --all",
    "qlty:zizmor": "qlty check --filter=zizmor:zizmor/template-injection --all",
    "qlty:fresh": "bun run lint && bun run qlty && bun run qlty:zizmor && bun run qlty:smells",
    "blablalink:version": "bun ci/checkVersion.ts",
    "test:efficiency": "bun tests/efficiency-check.ts",
    "test": "bun test",
    "test:coverage": "rm -rf coverage && bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "chore:release": "bun ci/chore_release.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.0.254",
    "@types/jsdom": "^28.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/typescript6": "6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^3.2.1",
    "fflate": "^0.8.2",
    "jsdom": "^29.1.1",
    "jsdom-global": "^3.0.2",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}