{
  "name": "shiftypad-extension",
  "version": "0.0.17",
  "description": "Analytics extension for Blablalink Union Raid management.",
  "apexcharts_browser": "https://cdn.jsdelivr.net/npm/apexcharts@5.3.6",
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "clean:build": "bun run clean && bun run build && bun run release",
    "clean": "rm -rf dist",
    "download:apex": "bun ci/downloadApex.ts",
    "build": "bun ci/build.ts",
    "release": "bun ci/release.ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"ci/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"ci/**/*.ts\" --fix",
    "qlty": "qlty check --all",
    "qlty:smells": "qlty smells --all",
    "qlty:zizmor": "qlty check --filter=zizmor:zizmor/template-injection --all",
    "blablalink:version": "bun ci/checkVersion.ts",
    "test:efficiency": "bun tests/efficiency-check.ts",
    "test": "bun test",
    "test:coverage": "rm -rf coverage && bun test --coverage --coverage-reporter=lcov --coverage-reporter=text"
  },
  "keywords": [],
  "author": "sinkaroid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScathachGrip/shiftypad-extension.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/chrome": "^0.0.254",
    "@types/jsdom": "^28.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.4",
    "fflate": "^0.8.2",
    "jsdom": "^29.1.1",
    "jsdom-global": "^3.0.2",
    "typescript": "^6.0.3"
  }
}