  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/chrome": "^0.0.254",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.4",
    "fflate": "^0.8.2",
    "typescript": "^6.0.3"
  }
}