{
  "name": "shiftypad-extension",
  "version": "0.0.1",
  "description": "blablalink.com extension",
  "apexcharts_browser": "https://cdn.jsdelivr.net/npm/apexcharts@5.3.6",
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "clean": "rm -rf dist",
    "download:apex": "bun ci/downloadApex.ts",
    "build": "bun ci/build.ts",
    "release": "bun ci/release.ts",
    "clean:build": "bun run clean && bun run build && bun run release",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "keywords": [],
  "author": "sinkaroid",
  "repository": {
    "type": "git",
