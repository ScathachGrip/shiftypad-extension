</footer>

<style>
  .footer {
    padding: 40px 0;
  }

  .footer-bottom {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-align: center;
  }

  .tech-item {
    display: inline;
    color: var(--text-dim);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .tech-item:hover {
    color: var(--text);
  }

  .tech-icon {
    height: 1.1em;
    width: 1.1em;
    display: inline-block;
    vertical-align: -0.15em;
    margin-right: 4px;
    transition: color 0.2s ease, filter 0.2s ease;
  }

  /* Specific premium hover micro-animations & glowing colors */
  .tech-item:hover .bun-icon {
    color: #ffc777;
    filter: drop-shadow(0 0 4px rgba(255, 199, 119, 0.5));
  }

  .tech-item:hover .apex-icon {
    color: #008ffb;
    filter: drop-shadow(0 0 4px rgba(0, 143, 251, 0.5));
  }

  .tech-item:hover .astro-icon {
    color: #ff5d01;
    filter: drop-shadow(0 0 4px rgba(255, 93, 1, 0.5));
  }

  .tech-item:hover .ts-icon {
    color: #3178c6;
    filter: drop-shadow(0 0 4px rgba(49, 120, 198, 0.5));
  }
</style>
