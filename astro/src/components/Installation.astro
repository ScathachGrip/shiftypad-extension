---
---
<section id="installation" class="section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Installation</span>
      <h2>Get started in <span class="gradient-text">less two minutes</span></h2>
      <p>Download the ZIP and load it in Chrome developer mode.</p>
    </div>

    <div class="install-wrapper">
      <!-- Steps Column -->
      <div class="steps-flow">
        <div class="flow-line"></div>

        <!-- Step 1 -->
        <div class="flow-step">
          <div class="flow-dot">1</div>
          <div class="flow-content">
            <h3>Download the ZIP</h3>
            <p>Get the latest release of <code>shiftypad-extension.zip</code></p>
            <div class="flow-action">
              <a href="https://github.com/ScathachGrip/shiftypad-extension/releases" target="_blank" rel="noopener noreferrer" class="install-btn">
                Latest Release
                <svg class="arrow-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flow-step">
          <div class="flow-dot">2</div>
          <div class="flow-content">
            <h3>Extract the archive</h3>
            <p>Extract to a permanent folder on your machine.</p>
            <div class="flow-note">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span>Keep the folder in a place where it will not be moved or deleted.</span>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flow-step">
          <div class="flow-dot">3</div>
          <div class="flow-content">
            <h3>Load in Chrome</h3>
            <p>Open <code>chrome://extensions</code>, enable <strong>Developer mode</strong>, click <strong>Load unpacked</strong>, and select the folder. You'll see a new Shiftypad floating action icon appear on the bottom-right corner of the Blablalink.
            </p>
            <img src={`${import.meta.env.BASE_URL}favicon.png`} alt="Shiftypad" class="flow-favicon" />
    
          </div>
        </div>
      </div>

      <!-- Video Showcase Column -->
      <div class="video-showcase">
        <div class="video-container">
          <video id="guide-player" playsinline controls>
            <source src="/project/guide.mp4" type="video/mp4">
          </video>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header h2 {
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .install-wrapper {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: start;
    margin-top: 48px;
  }

  /* Left Panel Timeline Flow */
  .steps-flow {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .flow-line {
    position: absolute;
    left: 16px;
    top: 16px;
    bottom: 16px;
    width: 1px;
    background: var(--border);
    z-index: 1;
  }

  .flow-step {
    position: relative;
    display: flex;
    gap: 24px;
    z-index: 2;
  }

  .flow-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    font-family: var(--font);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-dim);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .flow-step:hover .flow-dot {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--primary-dim);
  }

  .flow-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 3px;
  }

  .flow-content h3 {
    font-family: var(--font);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--text);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .flow-content p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .flow-content code {
    background: var(--code-bg);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--text);
    font-size: 0.85rem;
    font-family: var(--font-mono);
    border: 1px solid var(--border);
  }

  .flow-action {
    margin-top: 4px;
  }

  .install-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font);
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    padding: 8px 18px;
    background: var(--color-primary);
    border-radius: var(--radius-sm);
    width: fit-content;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .install-btn:hover {
    background: var(--color-primary-dim);
    color: #fff;
  }

  .arrow-icon {
    transition: transform 0.15s ease;
  }

  .install-btn:hover .arrow-icon {
    transform: translate(2px, -2px);
  }

  .flow-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--color-primary);
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-top: 4px;
  }

  .flow-note svg {
    margin-top: 2px;
    color: var(--color-primary);
    flex-shrink: 0;
  }



  /* Right Panel Video Showcase */
  .video-showcase {
    position: sticky;
    top: 100px;
  }

  .video-container {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: 12px;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  [data-theme="dark"] .video-container {
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.15);
  }

  .video-container:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 30px rgba(108, 92, 231, 0.04);
  }

  .video-container :global(.plyr) {
    border-radius: var(--radius-md) !important;
    overflow: hidden;
  }

  /* Responsive Queries */
  @media (max-width: 992px) {
    .install-wrapper {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .video-showcase {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .steps-flow {
      gap: 32px;
    }

    .flow-line {
      left: 12px;
    }

    .flow-dot {
      width: 24px;
      height: 24px;
      font-size: 0.75rem;
    }

    .flow-step {
      gap: 16px;
    }
  }

  .flow-favicon {
    display: block;
    width: 64px;
    height: 64px;
    margin-top: 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    padding: 6px;
    background: var(--surface);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }
</style>

<script>
  import 'plyr/dist/plyr.css';
  import Plyr from 'plyr';

  document.addEventListener('DOMContentLoaded', () => {
    new Plyr('#guide-player', {
      controls: ['play-large', 'play', 'progress', 'current-time', 'duration', 'mute', 'volume', 'fullscreen'],
    });
  });
</script>
