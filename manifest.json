{
  "manifest_version": 3,
  "name": "shiftypad-extension",
  "version": "0.1.6",
  "description": "Analytics extension for Blablalink Union Raid management.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://www.blablalink.com/*"
  ],
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.blablalink.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "dist/serviceWorker.js"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "32": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png",
        "assets/dor.mp3",
        "assets/d2.png",
        "assets/interact.png",
        "assets/fonts/Poppins-Regular.woff2",
        "assets/fonts/Poppins-SemiBold.woff2",
        "assets/fonts/Poppins-Black.woff2"
      ],
      "matches": [
        "https://www.blablalink.com/*"
      ]
    }
  ],
  "version_name": "0.1.6-dkdhsevv-aegis.14357"
}